[Unit]
Description=Lab Server Health central stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lab-server-health-dashboard
EnvironmentFile=/etc/lab-server-health/dashboard.env
ExecStart=/usr/bin/docker compose up --detach --wait
ExecReload=/usr/bin/docker compose up --detach --wait
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
