[Unit]
Description=Encrypted off-host backup for Lab Server Health
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/lab-server-health-dashboard
EnvironmentFile=/etc/lab-server-health/dashboard.env
ExecStart=/usr/bin/docker compose --profile operations run --rm backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
